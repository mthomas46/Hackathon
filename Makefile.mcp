# Makefile for MCP Ecosystem Management
# Provides preflight checks, validation, and unified startup

.PHONY: help preflight validate-config validate-network validate-ports start-infrastructure start-services start stop logs health test clean

# Colors for output
RED := \033[0;31m
GREEN := \033[0;32m
YELLOW := \033[0;33m
BLUE := \033[0;34m
NC := \033[0m # No Color

# Configuration
COMPOSE_FILE := docker-compose-mcp-ecosystem.yml
NETWORK_NAME := ams
PYTHON := python3

help:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  MCP Ecosystem Management$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@echo "$(GREEN)Validation & Preflight:$(NC)"
	@echo "  make preflight          - Run all preflight checks"
	@echo "  make validate-config    - Validate service configurations"
	@echo "  make validate-network   - Validate Docker network setup"
	@echo "  make validate-ports     - Check for port conflicts"
	@echo ""
	@echo "$(GREEN)Service Management:$(NC)"
	@echo "  make start-infrastructure - Start infrastructure services only"
	@echo "  make start-services      - Start all MCP workflow services"
	@echo "  make start              - Start complete ecosystem (preflight + all)"
	@echo "  make stop               - Stop all services"
	@echo "  make restart            - Restart all services"
	@echo ""
	@echo "$(GREEN)Monitoring:$(NC)"
	@echo "  make logs               - Show logs for all services"
	@echo "  make health             - Check health of all services"
	@echo "  make status             - Show service status"
	@echo ""
	@echo "$(GREEN)Testing & Validation:$(NC)"
	@echo "  make test               - Run validation demo script"
	@echo "  make test-e2e           - Run E2E tests"
	@echo ""
	@echo "$(GREEN)Cleanup:$(NC)"
	@echo "  make clean              - Remove containers and volumes"
	@echo "  make clean-all          - Remove everything including network"
	@echo ""

preflight: validate-config validate-network validate-ports
	@echo "$(GREEN)✓ All preflight checks passed$(NC)"

validate-config:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Validating Service Configurations$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@echo "$(YELLOW)→ Checking Python installation...$(NC)"
	@$(PYTHON) --version || (echo "$(RED)✗ Python not found$(NC)" && exit 1)
	@echo "$(GREEN)✓ Python installed$(NC)"
	@echo ""
	@echo "$(YELLOW)→ Checking required Python packages...$(NC)"
	@$(PYTHON) -c "import pydantic" 2>/dev/null || (echo "$(RED)✗ pydantic not installed. Run: pip install pydantic$(NC)" && exit 1)
	@echo "$(GREEN)✓ pydantic installed$(NC)"
	@echo ""
	@echo "$(YELLOW)→ Validating docker-compose file...$(NC)"
	@docker-compose -f $(COMPOSE_FILE) config > /dev/null || (echo "$(RED)✗ Invalid docker-compose file$(NC)" && exit 1)
	@echo "$(GREEN)✓ docker-compose file valid$(NC)"
	@echo ""
	@echo "$(GREEN)✓ Configuration validation complete$(NC)"
	@echo ""

validate-network:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Validating Docker Network$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@echo "$(YELLOW)→ Checking Docker daemon...$(NC)"
	@docker info > /dev/null 2>&1 || (echo "$(RED)✗ Docker daemon not running$(NC)" && exit 1)
	@echo "$(GREEN)✓ Docker daemon running$(NC)"
	@echo ""
	@echo "$(YELLOW)→ Checking AMS network...$(NC)"
	@docker network inspect $(NETWORK_NAME) > /dev/null 2>&1 || \
		(echo "$(YELLOW)  Network '$(NETWORK_NAME)' does not exist, will be created on startup$(NC)")
	@docker network inspect $(NETWORK_NAME) > /dev/null 2>&1 && \
		echo "$(GREEN)✓ Network '$(NETWORK_NAME)' exists$(NC)" || true
	@echo ""
	@echo "$(GREEN)✓ Network validation complete$(NC)"
	@echo ""

validate-ports:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Checking Port Availability$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@echo "$(YELLOW)→ Checking critical ports...$(NC)"
	@for port in 5700 8022 8014 8016 8103 8104 9092 6379 11434; do \
		if lsof -i :$$port > /dev/null 2>&1; then \
			echo "$(YELLOW)  ⚠  Port $$port is in use$(NC)"; \
		else \
			echo "$(GREEN)  ✓ Port $$port available$(NC)"; \
		fi; \
	done
	@echo ""
	@echo "$(GREEN)✓ Port check complete$(NC)"
	@echo ""

start-infrastructure:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Starting Infrastructure Services$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@docker-compose -f $(COMPOSE_FILE) up -d kafka zookeeper redis ollama elasticsearch
	@echo ""
	@echo "$(YELLOW)⏳ Waiting for infrastructure to be healthy (30s)...$(NC)"
	@sleep 30
	@echo "$(GREEN)✓ Infrastructure started$(NC)"
	@echo ""

start-services:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Starting MCP Workflow Services$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@docker-compose -f $(COMPOSE_FILE) up -d mcp-logs kafka-ingestion-service llm-tagging-pipeline mcp-local-llm mcp-package-manager mcp-evergreen-docs
	@echo ""
	@echo "$(YELLOW)⏳ Waiting for services to be healthy (20s)...$(NC)"
	@sleep 20
	@echo "$(GREEN)✓ Services started$(NC)"
	@echo ""

start: preflight start-infrastructure start-services
	@echo "$(GREEN)✓ Complete MCP ecosystem started successfully$(NC)"
	@echo ""
	@echo "$(BLUE)Run 'make health' to check service status$(NC)"
	@echo "$(BLUE)Run 'make test' to validate the workflow$(NC)"
	@echo ""

stop:
	@echo "$(YELLOW)Stopping all services...$(NC)"
	@docker-compose -f $(COMPOSE_FILE) down
	@echo "$(GREEN)✓ All services stopped$(NC)"

restart: stop start

logs:
	@docker-compose -f $(COMPOSE_FILE) logs -f

status:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Service Status$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@docker-compose -f $(COMPOSE_FILE) ps
	@echo ""

health:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Service Health Check$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@for port in 5700 8022 8014 8103 8104 8016; do \
		printf "Port $$port: "; \
		curl -s http://localhost:$$port/health 2>/dev/null | $(PYTHON) -c "import sys,json; print(json.load(sys.stdin).get('status', 'UNKNOWN'))" 2>/dev/null || echo "$(RED)OFFLINE$(NC)"; \
	done
	@echo ""

test:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Running Validation Demo$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@$(PYTHON) demo_mcp_workflow_validation.py

test-e2e:
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo "$(BLUE)  Running E2E Tests$(NC)"
	@echo "$(BLUE)═══════════════════════════════════════════════════════════════$(NC)"
	@echo ""
	@pytest tests/e2e/ --mode=live -v

clean:
	@echo "$(YELLOW)Removing containers and volumes...$(NC)"
	@docker-compose -f $(COMPOSE_FILE) down -v
	@echo "$(GREEN)✓ Cleanup complete$(NC)"

clean-all: clean
	@echo "$(YELLOW)Removing network...$(NC)"
	@docker network rm $(NETWORK_NAME) 2>/dev/null || true
	@echo "$(GREEN)✓ Complete cleanup done$(NC)"
