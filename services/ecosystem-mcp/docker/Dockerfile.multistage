# =============================================================================
# Multi-Stage Dockerfile for Ecosystem MCP Service
# Optimized for smaller image size (30-50% reduction)
# =============================================================================

# =============================================================================
# Stage 1: Builder - Install dependencies
# =============================================================================
FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies (removed in final image)
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# =============================================================================
# Stage 2: Docker CLI - Get docker binary
# =============================================================================
FROM docker:latest AS docker-cli

# =============================================================================
# Stage 3: Runtime - Final minimal image
# =============================================================================
FROM python:3.11-slim-bookworm

# Metadata
LABEL maintainer="ecosystem-mcp"
LABEL description="Ecosystem MCP Service - Multi-stage optimized build"

# Set working directory
WORKDIR /app

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy Docker CLI from docker image
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY . .

# Create data directories
RUN mkdir -p /app/data/chroma_db /app/data/backups

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH=/root/.local/bin:$PATH

# Expose ports
EXPOSE 8000 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["uvicorn", "src.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]

