# Load Testing Configuration
# This file disables rate limiting and optimizes for high throughput testing

# Copy all your existing settings from .env
# Then override these specific testing settings:

# Disable/ease rate limiting for load tests
RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT=10000/minute
SEARCH_RATE_LIMIT=10000/minute
QUERY_RATE_LIMIT=10000/minute

# Database - increase pool for load testing
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=25

# Redis - increase connections for load testing
REDIS_MAX_CONNECTIONS=100

# Ollama - increase timeout for heavy load
OLLAMA_TIMEOUT=600

# Environment
APP_ENVIRONMENT=load_testing
LOG_LEVEL=WARNING  # Reduce logging overhead

# To use this configuration:
# 1. Stop the service
# 2. Copy: cp .env.load_testing .env
# 3. Restart: docker-compose restart
# 4. Run load tests
# 5. Restore: git checkout .env (if tracked) or restore from backup
