# MCP Infrastructure Service - Environment Variables
# Copy this file to .env and configure for your environment

# Service Configuration
SERVICE_NAME=mcp-infrastructure
SERVICE_API_PORT=5500
ENVIRONMENT=development

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_KEY_PREFIX=mcp:infra:
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# Memory Management
MAX_CONTEXT_ITEMS=10000
DEFAULT_TTL=3600
RING_BUFFER_SIZE=5000
CLEANUP_INTERVAL=300

# Event Processing
SUBSCRIBE_TO_MCP_EVENTS=true

# Integration with Ecosystem Services
LOG_COLLECTOR_URL=http://log-collector:5080
LOG_COLLECTOR_ENABLED=true
LLM_GATEWAY_URL=http://llm-gateway:5055
LLM_GATEWAY_ENABLED=true
MEMORY_AGENT_URL=http://memory-agent:5040
MEMORY_AGENT_SYNC_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Configuration
API_PREFIX=/api/v1
DOCS_URL=/docs
OPENAPI_URL=/openapi.json

# CORS
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# DDD Configuration
DDD_ARCHITECTURE=true

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10
