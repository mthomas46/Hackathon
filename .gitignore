# ============================================================================
# LLM Documentation Ecosystem - Comprehensive .gitignore
# ============================================================================
# Keep ONLY source code, configuration, and documentation
# Exclude ALL data, models, caches, builds, and generated files
# ============================================================================

# ============================================================================
# CRITICAL: Large Data Directories (21GB+ total)
# ============================================================================
# Docker persistent data volumes
services/ecosystem-mcp/data/
services/ecosystem-mcp-embedding/models/
services/ecosystem-mcp-dashboard/cache/

# Ollama models (21GB)
**/data/ollama/

# ChromaDB vector database (362MB)
**/data/chroma_db/

# PostgreSQL data (243MB)
**/data/postgresql/

# Embedding models (224MB)
**/data/embedding_models/

# Redis persistence (45MB)
**/data/redis/

# Service data directories
**/data/backups/

