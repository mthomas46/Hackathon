version: '3.8'
services:
  redis:
    image: redis:7-alpine
    ports:
    - 6379:6379
    command: redis-server --appendonly yes --maxmemory 512mb --maxmemory-policy allkeys-lru
    healthcheck:
      test:
      - CMD
      - redis-cli
      - ping
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
    - hackathon_default

  ollama:
    image: ollama/ollama:latest
    environment:
    - OLLAMA_API_HOST=0.0.0.0
    networks:
    - hackathon_external
    healthcheck:
      test:
      - CMD
      - curl
      - -f
      - http://localhost:11434/api/tags
      interval: 60s
      timeout: 20s
      retries: 6
      start_period: 120s
      redis:
        condition: service_healthy
  swagger-agent:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic httpx &&
      uvicorn main:app --host 0.0.0.0 --port 5010"
    volumes:
    - ./services/swagger-agent:/svc
    ports:
    - 5010:5010
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic redis httpx
      && uvicorn main:app --host 0.0.0.0 --port 5020"
    environment:
    - REDIS_API_HOST=redis
    - OLLAMA_API_HOST=http://ollama-consistency:11434
    volumes:
    ports:
    - 8085:5020
    depends_on:
      redis:
        condition: service_healthy
      ollama-consistency:
        condition: service_healthy
  reporting:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic httpx &&
      uvicorn main:app --host 0.0.0.0 --port 5030"
    environment:
    volumes:
    - ./services/reporting:/svc
    ports:
    - 8085:5030
    depends_on:
      ollama-consistency:
        condition: service_healthy
  frontend:
    build:
      context: ./services/frontend
      dockerfile: Dockerfile
    environment:
    - REAPI_PORTING_URL=http://reporting:5030
    ports:
    - 8085:8000
    depends_on:
      reporting:
        condition: service_started
  memory-agent:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic redis &&
      uvicorn main:app --host 0.0.0.0 --port 5040"
    environment:
    - REDIS_API_HOST=redis
    volumes:
    - ./services/memory-agent:/svc
    ports:
    - 8085:5040
    depends_on:
      redis:
        condition: service_healthy
  discovery-agent:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic httpx &&
      uvicorn main:app --host 0.0.0.0 --port 5045"
    environment:
    - ORCHESTRATOR_URL=http://orchestrator:5099
    volumes:
    - ./services/discovery-agent:/svc
    ports:
    - 8085:5045
    depends_on:
      orchestrator:
        condition: service_started
      redis:
        condition: service_started
  summarizer-hub:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic && uvicorn
      main:app --host 0.0.0.0 --port 5060"
    volumes:
    - ./services/summarizer-hub:/svc
    ports:
    - 8085:5060
    depends_on:
      redis:
        condition: service_healthy
  github-agent:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic httpx &&
      uvicorn main:app --host 0.0.0.0 --port 5000"
    environment:
    - EXTERNAL_GITHUB_TOKEN=${EXTERNAL_GITHUB_TOKEN}
    - REDIS_API_HOST=redis
    volumes:
    - ./services/github-agent:/svc
    ports:
    - 8085:5000
    depends_on:
        condition: service_healthy
    networks:
    - hackathon_default
    - hackathon_external
  jira-agent:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic httpx &&
      uvicorn main:app --host 0.0.0.0 --port 5001"
    environment:
    - OLLAMA_API_KEY=${OLLAMA_API_KEY:-changeme}
    - REDIS_API_HOST=redis
    volumes:
    - ./services/jira-agent:/svc
    ports:
    - 8085:5001
    depends_on:
        condition: service_healthy
    networks:
    - hackathon_default
    - hackathon_external
  confluence-agent:
    image: python:3.12-slim
    working_dir: /svc
    command: bash -lc "pip install --no-cache-dir fastapi uvicorn pydantic httpx &&
      uvicorn main:app --host 0.0.0.0 --port 5050"
    environment:
    - REDIS_API_HOST=redis
    volumes:
    - ./services/confluence-agent:/svc
    ports:
    - 8085:5050
    depends_on:
        condition: service_healthy
    networks:
    - hackathon_default
    - hackathon_external
networks:
  hackathon_default:
    name: doc-ecosystem
    driver: bridge
  hackathon_external:
    driver: bridge
